# Greg AI Playground - Environment Configuration
# Copy this file to .env and add your API keys

# ====================
# LLM PROVIDER (Required)
# ====================
# Default provider when not specified in API request
# Options: "anthropic", "openai", "google", "ollama"
LLM_PROVIDER=anthropic

# Default model when not specified in API request
# Anthropic: claude-3-5-haiku-20241022, claude-sonnet-4-20250514
# OpenAI: gpt-4o-mini, gpt-4o
# Google: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp
# Ollama: mistral, llama3, phi
LLM_MODEL=claude-3-5-haiku-20241022

# ====================
# API KEYS
# ====================
# Add keys for providers you want to use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ====================
# COST TRACKING
# ====================
DAILY_COST_LIMIT_USD=10.00
WARN_COST_THRESHOLD_USD=5.00

# ====================
# RAG SETTINGS
# ====================
# Embedding model (runs locally on CPU)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Document chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ====================
# DIRECTORIES
# ====================
UPLOAD_DIR=./uploads
VECTOR_STORE_DIR=./vector_stores

# ====================
# OLLAMA (Optional - only if using local models)
# ====================
# Host URL for Ollama (if not running on localhost)
OLLAMA_HOST=http://localhost:11434

# These are read by the Ollama server itself (not Greg)
# Set these in your shell environment or Ollama config
# OLLAMA_KEEP_ALIVE=5m       # How long to keep models loaded
# OLLAMA_NUM_PARALLEL=2      # Concurrent requests
