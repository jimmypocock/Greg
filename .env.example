# Greg API - Environment Configuration
# Copy this file to .env and configure your settings
#
# Variables marked [REQUIRED] must be set - the app will not start without them.
# Variables marked [OPTIONAL] have sensible defaults or auto-detect.

# ============================================================================
# REQUIRED - Infrastructure
# ============================================================================

# PostgreSQL connection URL
DATABASE_URL=postgresql://greg:greg@localhost:5433/greg

# Redis connection URL (for job queue)
REDIS_URL=redis://localhost:6379

# ============================================================================
# REQUIRED - Security
# ============================================================================

# Secret key for signing JWT tokens
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# ============================================================================
# REQUIRED - LLM Provider
# ============================================================================

# Provider: "anthropic", "openai", "google", "ollama"
LLM_PROVIDER=openai

# Model name (provider-specific)
# Anthropic: claude-sonnet-4-5-20250929 (primary), claude-haiku-4-5-20251015 (budget)
# Google: gemini-2.5-flash (primary), gemini-2.5-flash-lite (budget)
# OpenAI: gpt-5.1 (primary), gpt-5-mini (budget)
# Ollama: mistral, llama3, phi (whatever you have installed)
LLM_MODEL=gpt-5.1

# ============================================================================
# REQUIRED - Directories
# ============================================================================

# Where to store uploaded files
UPLOAD_DIR=./uploads

# Where to store vector indices
VECTOR_STORE_DIR=./vector_stores

# ============================================================================
# OPTIONAL - API Keys (for paid LLM providers)
# ============================================================================

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ============================================================================
# OPTIONAL - Embedding Provider
# ============================================================================

# Provider: "openai" (paid, 1536 dim) or "local" (free, 384 dim)
# If not set, auto-detects: uses OpenAI if OPENAI_API_KEY is set, otherwise local
# EMBEDDING_PROVIDER=local

# Model (provider-specific)
# OpenAI: text-embedding-3-small (default), text-embedding-ada-002, text-embedding-3-large
# Local: all-MiniLM-L6-v2 (default), all-mpnet-base-v2
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================================================
# OPTIONAL - Tuning Parameters (sensible defaults)
# ============================================================================

# Token expiration
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7
# MAX_SESSIONS_PER_USER=10

# Model parameters
# TEMPERATURE=0.7
# TOP_P=0.9

# Document chunking
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# MAX_CONTEXT_LENGTH=2048

# File handling
# MAX_FILE_SIZE_MB=100

# Performance tuning (adjust based on your hardware)
# NUM_THREADS=8
# BATCH_SIZE=4
# EMBEDDING_BATCH_SIZE=2
# MAX_MEMORY_GB=8

# ============================================================================
# OPTIONAL - Ollama (if using local models)
# ============================================================================

# OLLAMA_HOST=http://localhost:11434

# ============================================================================
# OPTIONAL - CORS (for web frontends)
# ============================================================================

# Comma-separated list of allowed origins
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Allow all origins (development only!)
# CORS_ALLOW_ALL=true
