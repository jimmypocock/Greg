# Greg AI Playground - Environment Configuration
# Copy this file to .env and configure your settings

# ====================
# DATABASE (Required)
# ====================
# PostgreSQL connection URL (recommended)
DATABASE_URL=postgresql://greg:greg@localhost:5433/greg

# Or use individual components
# DB_HOST=localhost
# DB_PORT=5433
# DB_USER=greg
# DB_PASSWORD=greg
# DB_NAME=greg

# ====================
# REDIS (Required for job queue)
# ====================
REDIS_URL=redis://localhost:6379

# ====================
# JWT AUTHENTICATION
# ====================
# Secret key for signing JWT tokens (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# IMPORTANT: Change this in production!
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ====================
# LLM PROVIDER
# ====================
# Default provider when not specified in API request
# Options: "anthropic", "openai", "google", "ollama"
LLM_PROVIDER=ollama

# Default model when not specified in API request
# Anthropic: claude-3-5-haiku-20241022, claude-sonnet-4-20250514
# OpenAI: gpt-4o-mini, gpt-4o
# Google: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp
# Ollama: mistral, llama3, phi
LLM_MODEL=mistral

# ====================
# API KEYS (for paid providers)
# ====================
# Only needed if using paid models (requires Pro tier)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ====================
# COST TRACKING
# ====================
DAILY_COST_LIMIT_USD=10.00
WARN_COST_THRESHOLD_USD=5.00

# ====================
# RAG SETTINGS
# ====================
# Embedding model (runs locally on CPU)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Document chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ====================
# DIRECTORIES
# ====================
UPLOAD_DIR=./uploads
VECTOR_STORE_DIR=./vector_stores

# ====================
# OLLAMA (if using local models)
# ====================
OLLAMA_HOST=http://localhost:11434

# ====================
# CORS (for web frontends)
# ====================
# Comma-separated list of allowed origins
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Allow all origins (development only!)
# CORS_ALLOW_ALL=true
